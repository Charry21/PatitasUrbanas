# Variante SOLO para este entorno de nube: identica a app/Dockerfile salvo el
# paso marcado DESVIACION. El intento 2 importo solo el primer certificado de
# la CA del proxy y Maven siguio fallando con PKIX; aqui se instalan en el
# almacen del sistema todas las CA de salida del entorno
# (/usr/local/share/ca-certificates/*.crt del host) y se regenera el cacerts
# del JDK. app/Dockerfile no se modifica.
FROM maven:3.9.9-eclipse-temurin-21 AS build
# DESVIACION: confiar en las CA de intercepcion TLS del entorno
COPY --from=cas *.crt /usr/local/share/ca-certificates/
RUN update-ca-certificates && for f in /usr/local/share/ca-certificates/*.crt; do \
      csplit -s -z -f /tmp/ca- "$f" '/-----BEGIN CERTIFICATE-----/' '{*}'; \
      for c in /tmp/ca-*; do keytool -importcert -noprompt -cacerts -storepass changeit -alias "$(basename $f)-$(basename $c)" -file "$c"; done; rm -f /tmp/ca-*; \
    done
WORKDIR /workspace
COPY pom.xml .
COPY src ./src
RUN mvn -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/target/patitas-urbanas-api-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 3000
ENTRYPOINT ["java", "-jar", "app.jar"]
